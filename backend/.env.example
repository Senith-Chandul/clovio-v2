# Copy to backend/.env and fill in. Never commit .env.

# Required. Signs login tokens. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres on Supabase: use the Session pooler URL. postgres:// is rewritten for psycopg 3.
# Leave unset to use a local SQLite file (backend/dev.db).
DATABASE_URL=

# How long a login lasts, in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Deployed frontend origins, comma-separated, e.g. https://clovio.vercel.app.
# Localhost on any port is always allowed.
ALLOWED_ORIGINS=

# AI. Groq's key is enough; DeepSeek, when set, is tried first. Groq retires models, so the
# model name lives here (default openai/gpt-oss-120b).
GROQ_API_KEY=
AI_MODEL=
# Speech to text for voice commands (Groq Whisper; default whisper-large-v3-turbo).
WHISPER_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Sign in with Google and/or Microsoft, which also connects their calendar. Each provider appears on the
# sign-in page only when its ID and secret are set. Redirect URIs to register with the provider:
#   {API_URL}/api/auth/google/callback and {API_URL}/api/auth/microsoft/callback
# Google Cloud: enable the Google Calendar API (APIs & Services > Library), or every calendar call fails;
#   OAuth client of type "Web application"; consent screen scopes openid, email, profile,
#   .../auth/calendar.events and .../auth/calendar.freebusy; in Testing mode add each pilot user as a test user.
# Microsoft Entra: app registration for "accounts in any organizational directory and personal Microsoft
#   accounts"; Web platform; delegated permission Calendars.ReadWrite; in Token configuration add the
#   optional ID-token claims email and xms_edov (work accounts can't sign in without them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Who may create an account with Google or Microsoft without being invited to a project first:
# comma-separated emails and/or @domains (e.g. owner@gmail.com,@client.com), or * for anyone.
# Empty: invite-only. Anyone already invited can always sign in. In production, list the managers.
NEW_ACCOUNT_EMAILS=
# Public URLs of this API and of the web app (defaults: http://localhost:8000 and http://localhost:5173).
API_URL=
FRONTEND_URL=
# Fernet key for stored calendar tokens. Optional: derived from SECRET_KEY when unset. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=

# Email + password sign-up, for dev and demo accounts only. Leave false in production:
# a password sign-up doesn't prove the person owns the email.
ALLOW_SIGNUP=true
